{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile"
  },
  "deploy": {
    "startCommand": "pnpm --filter saleor-app-payment-stripe migrate:postgres",
    "restartPolicyType": "NEVER"
  }
}
