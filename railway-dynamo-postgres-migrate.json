{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile"
  },
  "deploy": {
    "startCommand": "pnpm migrate:dynamo-postgres ${MIGRATION_MODE:-inventory}",
    "restartPolicyType": "NEVER"
  }
}
